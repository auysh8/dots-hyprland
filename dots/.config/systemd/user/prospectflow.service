[Unit]
Description=ProspectFlow Modern Outreach & CRM Service
Requires=prospectflow.socket
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/auysh/Projects/outreach-dashboard
ExecStart=/usr/bin/node /home/auysh/Projects/outreach-dashboard/server/index.js
Restart=on-failure
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
